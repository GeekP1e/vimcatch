    "services:",
    "  api:",
    "    environment:",
    "      - NODE_ENV=production",
    "  worker:",
    "    environment:",
    "      - QUEUE=emails",
    "  scheduler:",
    "    environment:",
    "      - CRON=0 * * * *"
  ],
