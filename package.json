{
  "name": "vimcatch",
  "description": "Interactive terminal-style Vim training game",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "npm run build:content && node tests/contract/runner.js",
    "test:golden": "npm run build:content && node tests/golden/runner.js",
    "build:content": "node scripts/build-content.js",
    "build:css": "tailwindcss -i css/tailwind-input.css -o css/tailwind.css --minify",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "node scripts/build-content.js && npm run build:css && eslint . && node tests/contract/runner.js && node tests/golden/runner.js && vitest run && vite build"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@tailwindcss/cli": "4.3.0",
    "eslint": "^9.6.0",
    "globals": "^15.8.0",
    "happy-dom": "^21.0.1",
    "prettier": "^3.3.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
